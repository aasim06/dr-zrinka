# KlickTipp Management Credentials (used for assigning language tags)
KLICKTIPP_USERNAME=
KLICKTIPP_PASSWORD=

# KlickTipp Form Signin API Keys (https://api.klicktipp.com/subscriber/signin)
KLICKTIPP_APIKEY_CONTACT=
KLICKTIPP_APIKEY_STRATEGIC=
KLICKTIPP_APIKEY_JOURNAL=

# Event Registration Form API Keys (per event slug)
KLICKTIPP_APIKEY_EVENT_ZAGREB_DEC_2026=
KLICKTIPP_APIKEY_EVENT_ZAGREB_OCT_2026=
KLICKTIPP_APIKEY_EVENT_DEFAULT=

# Optional Double-Opt-In list ID fallback for /api/subscribe
KLICKTIPP_LIST_ID=

# Firebase Cloud Firestore (Service Account from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or paste the full single-line Service Account JSON instead of the 3 vars above:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Single-Admin Authentication (/admin/login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Executive AI Concierge (configure OPENAI_API_KEY or GEMINI_API_KEY)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Firebase Web Client SDK + Google Sign-In (Firebase Console -> Project Settings -> Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional comma-separated Google emails allowed to access /admin (in addition to ADMIN_EMAIL)
ADMIN_GOOGLE_EMAILS=
